# Copy this file to ".env" and fill in real values. NEVER commit ".env".
NODE_ENV=development
PORT=5000

# Paste your MongoDB Atlas connection string here (in your own .env only)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# REQUIRED. At least 32 random characters; the server refuses to start with a short, placeholder or repetitive value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Number + d/h/m (7d, 12h, 30m). Anything else stops the server at startup with a clear message.
JWT_EXPIRES_IN=7d

# Comma-separated list of EXACT allowed frontend origins. Production: https only, no "*" (e.g. https://your-app.vercel.app).
# Also used by the CSRF check: browsers' POST/PUT/PATCH/DELETE from any other origin are rejected with 403.
CORS_ORIGIN=http://localhost:3000

# Cookie SameSite: lax | strict | none (any case). Local development: lax.
# PRODUCTION with the frontend on Vercel and the API on Render (different sites): none  (it is forced Secure).
# If you leave it unset in production the server prints a warning, because login will not stick across sites.
COOKIE_SAMESITE=lax

# ---- Optional tuning (defaults shown) ----
# AUTH_RATE_LIMIT_MAX=20            # login/register attempts per IP per 15 min
# LOGIN_ACCOUNT_RATE_LIMIT_MAX=10   # FAILED logins per account per 15 min
# UPLOAD_RATE_LIMIT_MAX=15          # resume uploads per signed-in user per hour
# PDF_MAX_PAGES=15                  # only the first N pages of a resume are parsed
# PDF_PARSE_TIMEOUT_MS=8000         # resume parsing gives up after this long
# KEEP_ALIVE_TIMEOUT_MS=120000      # keep above the host proxy's idle timeout (prevents random 502s)

# OPTIONAL, for database integration tests only (npm test). Use a SEPARATE database whose name contains "test",
# e.g. mongodb+srv://<user>:<pass>@<cluster-host>/nicheJobBoard_test?retryWrites=true&w=majority
# MONGO_URI_TEST=

# ---- Razorpay payments (use TEST keys: they start with rzp_test_) ----
# Dashboard -> Account & Settings -> API Keys. The secret is shown once; never commit it or share it.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Account & Settings -> Webhooks: the secret YOU type when creating the webhook.
RAZORPAY_WEBHOOK_SECRET=
# Optional plan settings (server-side only). Price in paise: 49900 = INR 499.
FEATURED_PRICE_PAISE=49900
FEATURED_DAYS=7

# ---- Email (Resend: https://resend.com) ----
# Create an API key in Resend. EMAIL_FROM must be a sender on a domain you verified in Resend.
# For first tests you may use: EMAIL_FROM="NicheHire <onboarding@resend.dev>" (Resend then delivers only to your own account email).
RESEND_API_KEY=
EMAIL_FROM=
# Public URL of the website (used for links inside emails), e.g. https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000
