# Copy this file to ".env.local" for local development:   cp .env.local.example .env.local
# On Vercel, set the same variable in Project -> Settings -> Environment Variables.

# Public URL of the backend API, with no trailing slash.
#   local development: http://localhost:5000
#   production:        https://<your-render-service>.onrender.com   (rebuild/redeploy after changing it)
# It is public by design: never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:5000
